{
  "name": "@beltrans/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API BELTRANS (Node.js / Express) — capture et traitement des demandes de devis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "retention": "tsx scripts/retention.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@beltrans/shared": "*",
    "@prisma/client": "^6.16.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.35.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "resend": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "pino-pretty": "^13.1.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
