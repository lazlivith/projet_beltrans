# ─── Serveur ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL(s) du frontend autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
# Nombre de proxys devant l'API (0 en local ; 1 derrière Nginx/Render/Railway…)
TRUST_PROXY=0
LOG_LEVEL=info

# ─── Base de données PostgreSQL ──────────────────────────────────────────
# Local (pgAdmin) : base beltrans_db
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/beltrans_db?schema=public"
# Connexion directe pour les migrations (identique en local ; port 5432 direct sur Supabase)
DIRECT_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/beltrans_db?schema=public"

# ─── Anti-spam : Cloudflare Turnstile (clé secrète) ──────────────────────
# Clé de test toujours valide : 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ─── Rate limiting : Upstash Redis (3 devis / heure / IP) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── E-mails : Resend ────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="BELTRANS <devis@beltrans.com>"
QUOTE_NOTIFICATION_EMAILS=contact@beltrans.com

# ─── WhatsApp Business Cloud API (optionnel) ─────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEAM_NUMBER=242066030653
WHATSAPP_TEMPLATE_NAME=new_quote_alert
WHATSAPP_TEMPLATE_LANG=fr
